.venv/
.idea/
.agents/
.codex/

__pycache__/
**/__pycache__/
*.py[cod]

# Large/raw local datasets.
data/raw/*
!data/raw/.gitkeep
data/audio/*
!data/audio/.gitkeep

# Intermediate generated data. Keep only the current passage selection.
data/generation/*
!data/generation/
!data/generation/passages.csv
!data/generation/questions_a.csv
!data/generation/tts_fallback.py
!data/generation/make_generation_requests.py
!data/generation/merge_responses.py
!data/generation/filter.py
!data/generation/candidates.jsonl
!data/generation/candidates_*.jsonl
!data/generation/filter_log_*.csv
!data/generation/responses/
data/generation/responses/*
!data/generation/responses/b_v2.jsonl
!data/generation/responses/c_v2.jsonl
!data/generation/requests/
data/generation/requests/*
!data/generation/requests/.gitkeep
!data/generation/prompts/
!data/generation/prompts/*.txt

# Run outputs & model artifacts (added with repo skeleton, 2026-07-08)
results/**/*.jsonl
results/**/*.json
*.ckpt
*.safetensors
*.zip
.ipynb_checkpoints/

# Literature PDFs — local-only, download guide in papers/README.md
papers/*.pdf

# ...but run RESPONSES and JUDGED files are small and irreplaceable (manual B grades) - keep them
!results/**/responses.jsonl
!results/**/responses_judged.jsonl

# Ad-hoc local working dirs some_name_GITIGNORE/ -- never tracked, whatever the name
*_GITIGNORE/

# LaTeX build artifacts -- the PDF is produced from paper/*.tex, never edited by hand.
paper/*.pdf
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk

# Probing: keep the small artifacts that let the AUROC tables be rebuilt, drop the
# tensors (representations.npz is 43 MB, the per-token states under full/ are ~750 MB).
results/probing/**/*.npz
!results/probing/**/soft_labels*.jsonl
!results/probing/entropy.jsonl
!results/probing/**/auroc.json
